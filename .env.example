# ════════════════════════════════════════════════════════════════════════════════
# PARTNER.MODERN — CONFIGURAÇÃO LOCAL (.env.example)
# ════════════════════════════════════════════════════════════════════════════════
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env (git-ignored)
# 2. Configure os valores conforme seu ambiente
# 3. Variáveis obrigatórias marcadas com ⚠️ OBRIGATÓRIO
# 4. As variáveis são carregadas via IConfiguration (ASP.NET Core)
# 5. Use double underscore (__) para hierarquia em variáveis de ambiente
#
# ════════════════════════════════════════════════════════════════════════════════
# 🗄️  BANCO DE DADOS
# ════════════════════════════════════════════════════════════════════════════════

# ⚠️ OBRIGATÓRIO: String de conexão SQL Server
# Formato recomendado: Server={host};UID={usuario};PWD={senha};Database={database};
# Para autenticação Windows: Integrated Security=true;
ConnectionStrings__PartnerDb=Server=localhost;UID=usr_partner;PWD=Pass@2026!!!;Database=db_partner;

# ════════════════════════════════════════════════════════════════════════════════
# 🔐 AUTENTICAÇÃO JWT
# ════════════════════════════════════════════════════════════════════════════════

# Identificador do emissor do token JWT
Jwt__Issuer=Partner.Api

# Identificador da audiência (cliente/aplicação consumidora)
Jwt__Audience=Partner.Web

# ⚠️ OBRIGATÓRIO: Chave secreta para assinar tokens
# MÍNIMO 32 caracteres! Use uma chave aleatória forte em produção
# Exemplo gerado (use base64 ou string aleatória):
Jwt__SecretKey=0123456789abcdef0123456789abcdef0123456789=

# Tempo de expiração do token em minutos
Jwt__ExpirationMinutes=60

# ════════════════════════════════════════════════════════════════════════════════
# 🔑 AUTENTICAÇÃO MFA (Multi-Factor Authentication)
# ════════════════════════════════════════════════════════════════════════════════

# Tempo de validade do token MFA pendente em minutos
Mfa__MfaPendingTokenMinutes=10

# Número máximo de tentativas MFA antes de bloqueio
Mfa__MfaMaxAttempts=5

# Tempo de bloqueio MFA em minutos (após máximo de tentativas)
Mfa__MfaLockoutMinutes=15

# ════════════════════════════════════════════════════════════════════════════════
# 🔐 TRAVA DE SENHA (Password Lockout)
# ════════════════════════════════════════════════════════════════════════════════

# Número máximo de tentativas de senha antes de bloqueio
PasswordLockout__PasswordMaxAttempts=5

# Tempo de bloqueio de senha em minutos (após máximo de tentativas)
PasswordLockout__PasswordLockoutMinutes=15

# ════════════════════════════════════════════════════════════════════════════════
# 🐰 RABBITMQ — IMPORT (Fila de Jobs de Importação)
# ════════════════════════════════════════════════════════════════════════════════

# ⚠️ OBRIGATÓRIO: Hostname/IP do servidor RabbitMQ
# Exemplos: localhost, rabbitmq, rabbitmq.docker.internal, 192.168.1.100
RabbitMq__Host=localhost

# Porta do RabbitMQ (padrão: 5672)
RabbitMq__Port=5672

# Virtual Host no RabbitMQ (grupo lógico isolado)
RabbitMq__VirtualHost=partner

# ⚠️ OBRIGATÓRIO: Usuário para autenticação RabbitMQ
RabbitMq__Username=guest

# ⚠️ OBRIGATÓRIO: Senha para autenticação RabbitMQ
RabbitMq__Password=guest

# Exchange para publicação de eventos
RabbitMq__Exchange=partner.events

# Fila para jobs de importação
RabbitMq__ImportJobsQueue=partner.import.jobs

# Fila Dead-Letter para falhas de importação
RabbitMq__ImportDlqQueue=partner.import.dlq

# ════════════════════════════════════════════════════════════════════════════════
# 🐰 RABBITMQ — VTEX (Fila de Sincronização VTEX)
# ════════════════════════════════════════════════════════════════════════════════

# Hostname/IP do servidor RabbitMQ para VTEX (pode ser diferente do Import)
VtexRabbitMq__Host=localhost

# Porta do RabbitMQ para VTEX
VtexRabbitMq__Port=5672

# Virtual Host para VTEX
VtexRabbitMq__VirtualHost=partner

# ⚠️ OBRIGATÓRIO: Usuário para autenticação RabbitMQ VTEX
VtexRabbitMq__Username=guest

# ⚠️ OBRIGATÓRIO: Senha para autenticação RabbitMQ VTEX
VtexRabbitMq__Password=guest

# Exchange para eventos VTEX
VtexRabbitMq__Exchange=partner.events

# Fila para sincronização com VTEX
VtexRabbitMq__VtexSyncQueue=partner.vtex.sync

# Fila Dead-Letter para falhas VTEX
VtexRabbitMq__VtexDlqQueue=partner.vtex.dlq

# ════════════════════════════════════════════════════════════════════════════════
# 🌐 INTEGRAÇÃO VTEX
# ════════════════════════════════════════════════════════════════════════════════

# IMPORTANTE: Manter como 'false' em PRÉ-IMP-8
# Integração real será implementada em IMP-8
Vtex__Enabled=false

# URL base da API VTEX (ignorar se Enabled=false)
# Exemplo: https://api.vtex.com/lojabestoff
Vtex__BaseUrl=

# Chave de aplicação VTEX (ignorar se Enabled=false)
Vtex__AppKey=

# Token de aplicação VTEX (ignorar se Enabled=false)
Vtex__AppToken=

# Número de tentativas em caso de falha
Vtex__RetryCount=3

# Intervalo entre tentativas em milissegundos
Vtex__RetryDelayMs=1000

# ════════════════════════════════════════════════════════════════════════════════
# 📤 IMPORTAÇÃO E ARMAZENAMENTO
# ════════════════════════════════════════════════════════════════════════════════

# Diretório raiz para armazenar arquivos de importação
# Caminho relativo a partir da raiz de execução
Import__StorageRoot=imports

# ════════════════════════════════════════════════════════════════════════════════
# 🌍 CORS (Cross-Origin Resource Sharing)
# ════════════════════════════════════════════════════════════════════════════════

# Origins permitidas para CORS (pode adicionar múltiplas com índice)
# Exemplos:
#   http://localhost:4200
#   https://app.example.com
#   https://staging.example.com
Cors__AllowedOrigins__0=http://localhost:4200

# Para adicionar mais origins, use índices sequenciais:
# Cors__AllowedOrigins__1=https://app.example.com
# Cors__AllowedOrigins__2=https://staging.example.com

# ════════════════════════════════════════════════════════════════════════════════
# 📊 LOGGING — SERILOG (Structured Logging)
# ════════════════════════════════════════════════════════════════════════════════

# Nível mínimo de logging
# Valores: Verbose, Debug, Information, Warning, Error, Fatal
Serilog__MinimumLevel__Default=Information

# Override de nível para namespaces específicos
# Em desenvolvimento, você pode desabilitar logs do framework
# Serilog__MinimumLevel__Override__Microsoft=Information
# Serilog__MinimumLevel__Override__System=Information

# ════════════════════════════════════════════════════════════════════════════════
# 📡 LOGGING CENTRALIZADO — SEQ (Opcional)
# ════════════════════════════════════════════════════════════════════════════════

# Habilita/desabilita envio de logs para Seq
# Em desenvolvimento: true (se Seq está rodando), em produção: false
Serilog__Seq__Enabled=false

# URL do servidor Seq (ignorar se Enabled=false)
# Executar Seq: docker run --rm -it -p 5341:80 datalust/seq:latest
Serilog__Seq__ServerUrl=http://localhost:5341

# API Key para autenticação no Seq (deixar vazio se não requer autenticação)
Serilog__Seq__ApiKey=

# ════════════════════════════════════════════════════════════════════════════════
# 🌐 AMBIENTE ASP.NET CORE
# ════════════════════════════════════════════════════════════════════════════════

# Ambiente de execução
# Valores: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# ════════════════════════════════════════════════════════════════════════════════
# 📝 NOTAS IMPORTANTES
# ════════════════════════════════════════════════════════════════════════════════

# 1. SEGURANÇA:
#    - Nunca commit este arquivo com valores reais
#    - Usar variáveis de ambiente em produção
#    - Jwt__SecretKey deve ser uma string aleatória forte (mín 32 chars)

# 2. VARIÁVEIS DE AMBIENTE:
#    - Use syntaxe: SECTION__PROPERTY__SUBPROPERTY
#    - Exemplo: RabbitMq__Host, Jwt__SecretKey, Cors__AllowedOrigins__0

# 3. CARREGAMENTO:
#    - appsettings.json carrega valores padrão
#    - appsettings.Development.json override em desenvolvimento
#    - Variáveis de environment fazem override final

# 4. DEBUGGING:
#    - Logs são salvos em: logs/partner-api-{data}.json (rotação diária)
#    - Manter 7 dias de histórico
#    - Em dev, habilitar Seq para análise centralizada

# 5. RABBITMQ:
#    - Docker: docker run -it --rm --name rabbitmq -p 5672:5672 -p 15672:15672 rabbitmq:3-management
#    - Management: http://localhost:15672 (guest/guest)
#    - Certifique-se que virtual host 'partner' existe

# 6. SQL SERVER:
#    - Criar database: db_partner
#    - Criar usuário: usr_partner
#    - Executar migrations se necessário

# 7. DEPENDÊNCIAS OBRIGATÓRIAS:
#    ✅ SQL Server
#    ✅ RabbitMQ
#    ❌ Seq (opcional)

# ════════════════════════════════════════════════════════════════════════════════
# 🚀 PARA COMEÇAR LOCALMENTE
# ════════════════════════════════════════════════════════════════════════════════

# 1. Copie este arquivo:
#    cp .env.example .env

# 2. Configure os valores para seu ambiente

# 3. Execute o script de bootstrap:
#    Windows (CMD):  start_partner_local.cmd
#    PowerShell:     .\start_partner_local.ps1
#    Linux/macOS:    bash start_partner_local.sh

# 4. Acesse a aplicação:
#    Swagger: https://localhost:7111/swagger
#    Health:  https://localhost:7111/health

# ════════════════════════════════════════════════════════════════════════════════
