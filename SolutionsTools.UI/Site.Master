<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="SolutionsTools.UI.Site" %>

<!DOCTYPE html>

<html lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="icon" href="Img/favicon.png"/>

    <%--<link rel="canonical" href="https://getbootstrap.com/docs/4.0/examples/sticky-footer-navbar/">--%>

    ​<%@ Register Src="~/Controls/acModal.ascx" TagName="Modal" TagPrefix="md" %>

    <%-- Estilos customizados --%>
    <link href="Content/loader.css" rel="stylesheet" />

    <%-- Estilos template --%>
    <link href="Content/bootstrap.min.css" rel="stylesheet">
    <link href="Content/sticky-footer-navbar.css" rel="stylesheet">
    <link href="//code.jquery.com/ui/1.12.1/themes/smoothness/jquery-ui.css" rel="stylesheet">

    <%-- Javascript customizados --%>
    <script type="text/javascript" src="Scripts/loader.js"></script>

    <%-- Javascript template --%>
    <script src="//code.jquery.com/jquery-3.5.1.js"></script>
    <script src="//code.jquery.com/ui/1.12.1/jquery-ui.js"></script>
    <script src="Scripts/popper.min.js"></script>
    <script src="Scripts/bootstrap.min.js" type="text/javascript"></script>

    <style type="text/css">
        body {
	        overflow: auto;
        }
    </style>

    <%-- Title --%>
    <title>Partner Solution</title>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark fixed-top bg-dark" >
            <a class="navbar-brand" href="#"><img alt="" src="Img/logo.png" /></a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarCollapse" aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse" >
                <ul class="navbar-nav mr-auto" >
                    <li class="nav-item active">
                        <a class="nav-link" href="home.aspx">Home<span class="sr-only">(current)</span></a>
                    </li>
                    <li class="nav-item" runat="server" id="funcImpCsv" visible="false">
                        <a class="nav-link" href="Importar.aspx">Importar</a>
                    </li>
                    <li class="nav-item" runat="server" id="funcClientes" visible="false">
                        <a class="nav-link" href="Clientes.aspx">Clientes</a>
                    </li>
                    <li class="nav-item" runat="server" id="funcEmpresas" visible="false">
                        <a class="nav-link" href="Empresas.aspx">Empresas</a>
                    </li>
                    <li class="nav-item" runat="server" id="funcUsuarios" visible="false">
                        <a class="nav-link" href="Usuarios.aspx">Usuários</a>
                    </li>
                </ul>

                <div>
                    <button type="button" class="btn btn-primary" disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"></path>
                        </svg>
                    </button>
                    <span style="color: #FFF"><% Response.Write(SolutionsTools.UI.UserDataAccess.NomeUsuario); %></span>
                </div>

                <div style="margin-left: 10px">
                    <button onserverclick="btnLogoff_Click" runat="server" id="btnLogoff" class="btn btn-danger" >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-lock" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zM5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z" />
                        </svg>
                    </button>
                        
                    <span style="color: #FFF">Logout</span>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container">
        <form id="form1" runat="server">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            <md:Modal ID="acModal" runat="server" />
        </form>
        ​
        <div class="gcse-search"></div>
    </main>
    <footer class="footer">
        <div class="container" style="text-align: center">
            <span class="text-muted">© 2021 - Partner Solution - Todos os direitos reservados</span>
        </div>
    </footer>
    <script>window.jQuery || document.write('<script src="Scripts/jquery-slim.min.js"><\/script>')</script>
</body>
</html>
